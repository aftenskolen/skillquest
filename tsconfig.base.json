{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@skillquest/ui": ["../../packages/ui/src"],
      "@skillquest/db": ["../../packages/db/src"],
      "@skillquest/auth": ["../../packages/auth/src"],
      "@skillquest/utils": ["../../packages/utils/src"]
    }
  },
  "exclude": ["node_modules"]
}
